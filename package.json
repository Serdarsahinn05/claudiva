{
  "name": "claudiva",
  "version": "0.4.0",
  "description": "Multi-agent orchestration panel for Claude Code — run, watch and coordinate several agents in one project",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "multi-agent",
    "orchestration",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "author": "Serdarsahinn05",
  "homepage": "https://github.com/Serdarsahinn05/claudiva#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serdarsahinn05/claudiva.git"
  },
  "bugs": {
    "url": "https://github.com/Serdarsahinn05/claudiva/issues"
  },
  "type": "module",
  "bin": {
    "claudiva": "bin/claudiva.js"
  },
  "files": [
    "bin",
    "agents",
    "server/dist",
    "web/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "material-icon-theme": "^5.37.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

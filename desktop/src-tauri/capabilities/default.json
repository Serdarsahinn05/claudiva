{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Launcher (local page): pick a folder, start the server, window buttons",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "allow-node-version",
    "allow-recent-projects",
    "allow-forget-project",
    "allow-open-project"
  ]
}
